<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rlw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rl_widget_bg"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/rlw_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Runelift"
        android:textColor="#FF8A93A0"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/rlw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Runelift"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/rlw_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#FF8A93A0"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/rlw_btn"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rl_widget_btn"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Commencer"
        android:textColor="#FF0D0F12"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
